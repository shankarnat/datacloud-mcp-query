# Salesforce Connected App Credentials
SF_CLIENT_ID=your_salesforce_client_id
SF_CLIENT_SECRET=your_salesforce_client_secret

# Salesforce OAuth Configuration
SF_LOGIN_URL=login.salesforce.com
SF_CALLBACK_URL=http://localhost:55556/Callback

# For Heroku/Production: Use refresh token instead of browser-based OAuth
# To get a refresh token:
# 1. Run locally with SF_CLIENT_ID and SF_CLIENT_SECRET
# 2. Complete the browser OAuth flow once
# 3. Check logs for "Received refresh token" message
# 4. Copy that refresh token and set it as SF_REFRESH_TOKEN
SF_REFRESH_TOKEN=your_refresh_token_here

# MCP Server Configuration
MCP_TRANSPORT=http  # Use 'stdio' for local development, 'http' for Heroku
PORT=8000  # Heroku sets this automatically
HOST=0.0.0.0
MCP_PATH=/mcp

# Data Cloud Configuration (optional)
DEFAULT_LIST_TABLE_FILTER=%  # SQL LIKE pattern for filtering tables
