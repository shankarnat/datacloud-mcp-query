# Salesforce Connected App Configuration
# Required: Create a Connected App in Salesforce with these settings:
# - Callback URL: https://<your-app-name>.herokuapp.com/oauth/callback
# - OAuth Scopes: api, cdp_query_api, cdp_profile_api
# - PKCE enabled

SF_CLIENT_ID=your_client_id_here
SF_CLIENT_SECRET=your_client_secret_here

# Optional: Salesforce login URL (default: login.salesforce.com)
# Use test.salesforce.com for sandbox environments
SF_LOGIN_URL=login.salesforce.com

# Optional: Filter pattern for list_tables (SQL LIKE syntax, default: %)
DEFAULT_LIST_TABLE_FILTER=%

# Heroku Configuration
# Optional: Your Heroku app name (e.g., my-datacloud-mcp)
# If not set, the app will use the request URL
HEROKU_APP_NAME=your-heroku-app-name

# Flask Configuration
# Optional: Secret key for Flask sessions (auto-generated if not set)
# FLASK_SECRET_KEY=your_random_secret_key_here
