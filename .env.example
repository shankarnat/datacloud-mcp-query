# ============================================================================
# AUTHENTICATION METHODS (Choose ONE)
# ============================================================================

# METHOD 1: JWT Bearer Token Flow (RECOMMENDED for Production/Heroku)
# Best for server-to-server authentication, no browser needed
# See JWT_SETUP_GUIDE.md for complete setup instructions
SF_CLIENT_ID=your_salesforce_consumer_key
SF_USERNAME=your_salesforce_username@company.com
SF_JWT_PRIVATE_KEY=base64_encoded_private_key_here

# METHOD 2: Refresh Token Flow (Alternative for Production)
# SF_CLIENT_ID=your_salesforce_client_id
# SF_CLIENT_SECRET=your_salesforce_client_secret
# SF_REFRESH_TOKEN=your_refresh_token_here

# METHOD 3: Browser-Based OAuth (Local Development Only)
# SF_CLIENT_ID=your_salesforce_client_id
# SF_CLIENT_SECRET=your_salesforce_client_secret

# Salesforce Configuration
SF_LOGIN_URL=login.salesforce.com  # Use 'test.salesforce.com' for sandboxes
SF_CALLBACK_URL=http://localhost:55556/Callback  # Only needed for browser OAuth

# MCP Server Configuration
MCP_TRANSPORT=http  # Use 'stdio' for local development, 'http' for Heroku
PORT=8000  # Heroku sets this automatically
HOST=0.0.0.0
MCP_PATH=/mcp

# Data Cloud Configuration (optional)
DEFAULT_LIST_TABLE_FILTER=%  # SQL LIKE pattern for filtering tables
